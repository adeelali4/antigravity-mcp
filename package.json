{
  "name": "antigravity-mcp-server",
  "version": "0.6.4",
  "description": "Run several AI coding CLIs on one repo at once. Any agent (Claude Code, Cursor, Copilot, Codex, Gemini, OpenCode, Antigravity) can delegate work to any other, with path locking so they never overwrite each other, automatic failover when one hits its usage limit, and a live pixel-art office dashboard. Works on Windows, macOS and Linux.",
  "type": "module",
  "bin": {
    "antigravity-mcp-server": "src/cli.js"
  },
  "main": "src/server.js",
  "exports": {
    ".": "./src/server.js"
  },
  "files": [
    "src",
    "ui-dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/cli.js",
    "doctor": "node src/cli.js doctor",
    "ui": "node src/cli.js ui",
    "test": "node test/smoke.js",
    "ui:build": "cd ui && npm install && npm run build",
    "prepare": "node -e \"if(!require('fs').existsSync('ui-dist/index.html'))require('child_process').execSync('npm run ui:build',{stdio:'inherit'})\"",
    "prepublishOnly": "npm run ui:build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "smithery",
    "antigravity",
    "agy",
    "claude-code",
    "claude-desktop",
    "cursor",
    "cursor-agent",
    "windsurf",
    "github-copilot",
    "copilot",
    "copilot-cli",
    "gemini-cli",
    "opencode",
    "codex",
    "multi-agent",
    "ai-agents",
    "agent-orchestration",
    "delegation",
    "file-locking",
    "task-board",
    "retro-office",
    "developer-tools",
    "pair-programming",
    "visualization",
    "ai-agent-orchestration",
    "parallel-agents",
    "subagents",
    "agent-delegation",
    "agent-handoff",
    "rate-limit-failover",
    "usage-limit",
    "codex-cli",
    "cross-platform",
    "windows",
    "macos",
    "linux",
    "coding-agent",
    "agentic-coding",
    "background-agents",
    "agent-coordination",
    "concurrency",
    "mutex"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adeelali4/antigravity-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/adeelali4/antigravity-mcp/issues"
  },
  "homepage": "https://github.com/adeelali4/antigravity-mcp#readme"
}
